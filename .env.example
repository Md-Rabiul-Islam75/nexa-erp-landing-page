# Copy this file to ".env" and fill in the values for your environment.
# All VITE_* vars are PUBLIC (baked into the client bundle) — never put secrets here.

# ── Brand ────────────────────────────────────────────────
VITE_APP_NAME=NexaERP
VITE_COMPANY_NAME=Automation Services Ltd.
VITE_PARENT_BRAND=Nexalinx
VITE_WEBSITE=nexalinx.com

# ── Contact ──────────────────────────────────────────────
VITE_CONTACT_PHONE=+880 1306 660656
VITE_CONTACT_EMAIL=info@nexalinx.com

# General "WhatsApp" link — international format, digits only (no +, spaces, dashes)
VITE_WHATSAPP=8801306660656
# Demo-booking WhatsApp number (digits only) — booking confirmations are sent here
VITE_BOOKING_WHATSAPP=8801847364088

# Demo CTA target (anchor like #book-demo, or a full form/CRM URL)
VITE_DEMO_URL=#book-demo
# Google Calendar / Calendly appointment link (blank = hide the "Pick a time" button)
VITE_CALENDAR_URL=

# ── Integrations ─────────────────────────────────────────
# Crisp live-chat Website ID (blank = disable the chat bubble; chat is commented out for now)
VITE_CRISP_WEBSITE_ID=

# Reserved for a future backend (not used yet)
VITE_API_BASE_URL=
